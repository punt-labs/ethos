# Go build artifacts
/ethos
/validate-content
dist/
coverage.out

# Scratch/temp directory (TMPDIR set via .envrc)
.tmp/

# Legacy .ethos/ runtime tree (relocated to .punt-labs/ethos/ in v3.13.0).
# A v3.12.0 ethos binary still writing to .ethos/ in an active session
# would otherwise dirty the working tree until upgrade.
.ethos/

# Machine-local zone (DES-058): the live audit/mission write path lives
# here and must never be committed. Canonical org-wide form.
.punt-labs/**/local/**

# Machine-local file variants across every .punt-labs tool subtree: the
# `.local.` infix marks per-machine config and secrets that must never be
# committed — ethos ext secrets (<handle>.ext/<ns>.local.yaml, DES-057),
# biff/vox local config, and any future tool. One canonical rule instead of
# a per-tool nested .gitignore.
.punt-labs/**/*.local.*

# Quarry session-transcript captures: runtime dev-tool state (raw agent
# transcripts), never source. Matches biff/lux .gitignore phrasing for
# the same tool. A capture leaked to this repo's public history via
# release commits c5764fb/7759dd5 (pkit-kcps) before this rule existed.
.punt-labs/quarry/captures/

# Claude local settings
.claude/settings.local.json
.claude/*.local.md
.claude/scheduled_tasks.lock

# direnv

# MCP (project-local, not part of plugin distribution)
.mcp.json


# Lux config
Lux.ini

# Biff local
.biff.local
.biff

# LaTeX build artifacts
*.aux
*.bbl
*.bcf
*.blg
*.log
*.out
*.run.xml
*.synctex.gz
*.toc

# Z-spec / fuzz build artifacts
docs/*.mf
docs/*.sty
docs/*.fuzz
docs/*.pdf
.orphaned_at

# IDE
.idea/

# Worktrees
.worktrees/
.claude/worktrees/

# Bead daemon runtime state — issues.jsonl is the tracked source of truth
.beads/bd.sock*
.beads/daemon-error

# Claude Code session transcripts (ethos-<date>.jsonl at repo root)
ethos-*.jsonl

.envrc.local

# Generated research cache
research/

# ethos runtime (never track) — DES-058 live zone + mission locks
.punt-labs/ethos/missions/**/*.lock

# Store-level create locks (internal/mission, internal/mcp test fixtures) —
# runtime artifacts, never source. See ethos-qs0v.
**/.create.lock

# tests/e2e (L4 E2E tier): Python bytecode/tool caches and the venv. Keep
# tests/e2e/uv.lock tracked — it's the reproducibility contract.
tests/e2e/__pycache__/
tests/e2e/**/__pycache__/
tests/e2e/.venv/
tests/e2e/.pytest_cache/
tests/e2e/**/.pytest_cache/
tests/e2e/.ruff_cache/
tests/e2e/.mypy_cache/
