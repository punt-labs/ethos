{"ts":"2026-09-11T04:20:29.294278082Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-shell-8a310d7b0a566aee","agent_type":"worker-shell","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/apps/desk/package.json","new_string":"  \"dependencies\": {\n    \"react\": \"^19.1.0\",\n    \"react-dom\": \"^19.1.0\",\n    \"@tauri-apps/api\": \"^2\",\n    \"@tauri-apps/plugin-opener\": \"^2\",\n    \"@tauri-apps/plugin-shell\": \"^2\"\n  },","old_string":"  \"dependencies\": {\n    \"react\": \"^19.1.0\",\n    \"react-dom\": \"^19.1.0\",\n    \"@tauri-apps/api\": \"^2\",\n    \"@tauri-apps/plugin-opener\": \"^2\"\n  },","replace_all":false},"tool_input_hash":"cf67092f7299d15c7ded35191f0fe74c591643cbfffe274705aea9af7f00c09b","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/apps/desk/package.json\",\"new_string\":\"  \\\"dependencies\\\": {\\n    \\\"react\\\": \\\"^19.1.0\\\",\\n    \\\"react-dom\\\": \\\"^19.1.0\\\",\\n    \\\"@tauri-apps/api\\\": \\\"^2\\\",\\n    \\..."}
{"ts":"2026-09-11T04:20:32.082418972Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import type { MissionRow } from '../types'\n\n/** \"m-2026-07-21-001\" -\u003e \"m-…-07-21-001\" — matches the visual spec's\n * collapsed-year id shorthand; full id remains available on hover/L3. */\nexport function shortId(id: string): string {\n  return id.replace(/^m-\\d{4}-/, 'm-…-')\n}\n\nexport function truncate(text: string, max: number): string {\n  const clean = text.trim().replace(/\\s+/g, ' ')\n  if (clean.length \u003c= max) return clean\n  return clean.slice(0, max - 1).trimEnd() + '…'\n}\n\n/**\n * There is no title field anywhere in the mission data model (`find`,\n * `list`, and `show` all lack one) — this derives a row headline from\n * the most specific real text available, in order of preference, and\n * says so honestly when nothing usable exists.\n */\nexport function headline(row: MissionRow): { text: string; derived: boolean } {\n  const firstCriterion = row.success_criteria?.[0]\n  if (firstCriterion) return { text: truncate(firstCriterion, 100), derived: true }\n  const context = row.full?.context\n  if (context) return { text: truncate(context, 100), derived: true }\n  if (row.ticket) return { text: `${row.type ?? 'mission'} · ${row.ticket}`, derived: true }\n  return { text: '(no description recorded)', derived: false }\n}\n\nconst DAY_MS = 24 * 60 * 60 * 1000\n\nexport function formatDate(iso: string): string {\n  const d = new Date(iso)\n  return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })\n}\n\nexport function formatDateTime(iso: string): string {\n  const d = new Date(iso)\n  return d.toLocaleString(undefined, {\n    month: 'short',\n    day: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n  })\n}\n\nexport function formatClock(iso: string): string {\n  const d = new Date(iso)\n  return d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' })\n}\n\nexport function relativeAge(iso: string, now = Date.now()): string {\n  const then = new Date(iso).getTime()\n  const days = Math.round((now - then) / DAY_MS)\n  if (days \u003c= 0) return 'today'\n  if (days === 1) return '1d ago'\n  if (days \u003c 30) return `${days}d ago`\n  const months = Math.round(days / 30)\n  if (months \u003c 12) return `${months}mo ago`\n  return `${Math.round(months / 12)}y ago`\n}\n","file_path":"~/Coding/punt-labs/desk/spike/ui/src/lib/format.ts"},"tool_input_hash":"6989d918ac87a949aa92a150d8ac3dd99be6b49fbd1bd64431fbaeaf679d711d","tool_input_preview":"{\"content\":\"import type { MissionRow } from '../types'\\n\\n/** \\\"m-2026-07-21-001\\\" -\\u003e \\\"m-…-07-21-001\\\" — matches the visual spec's\\n * collapsed-year id shorthand; full id remains available ..."}
