{"ts":"2026-09-11T04:25:07.925085255Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import { useEffect, useMemo, useRef, useState } from 'react'\nimport { GROUP_ORDER, groupRows, type GroupKey } from '../lib/grouping'\nimport { headline } from '../lib/format'\nimport type { MissionRow } from '../types'\nimport { GroupHeader } from './GroupHeader'\nimport { MissionRowView } from './MissionRowView'\nimport { PeekPanel } from './PeekPanel'\n\nconst VIEWS = ['List', 'Board', 'Lanes'] as const\n\nexport function MissionsScreen({ rows }: { rows: MissionRow[] }) {\n  const [query, setQuery] = useState('')\n  const [view, setView] = useState\u003c(typeof VIEWS)[number]\u003e('List')\n  const searchRef = useRef\u003cHTMLInputElement\u003e(null)\n\n  const filtered = useMemo(() =\u003e {\n    const q = query.trim().toLowerCase()\n    if (!q) return rows\n    return rows.filter((r) =\u003e {\n      const h = headline(r).text.toLowerCase()\n      return (\n        r.id.toLowerCase().includes(q) ||\n        h.includes(q) ||\n        r.worker?.toLowerCase().includes(q) ||\n        r.leader?.toLowerCase().includes(q) ||\n        r.ticket?.toLowerCase().includes(q)\n      )\n    })\n  }, [rows, query])\n\n  const grouped = useMemo(() =\u003e groupRows(filtered), [filtered])\n\n  // Flat, group-ordered id list drives j/k navigation and default selection.\n  const flatIds = useMemo(() =\u003e {\n    const ids: string[] = []\n    for (const def of GROUP_ORDER) {\n      for (const r of grouped.get(def.key) ?? []) ids.push(r.id)\n    }\n    return ids\n  }, [grouped])\n\n  const [selectedId, setSelectedId] = useState\u003cstring | undefined\u003e(flatIds[0])\n\n  useEffect(() =\u003e {\n    if (selectedId \u0026\u0026 flatIds.includes(selectedId)) return\n    setSelectedId(flatIds[0])\n  }, [flatIds, selectedId])\n\n  useEffect(() =\u003e {\n    function onKeyDown(e: KeyboardEvent) {\n      if (document.activeElement === searchRef.current) {\n        if (e.key === 'Escape') searchRef.current?.blur()\n        return\n      }\n      if (e.key === '/') {\n        e.preventDefault()\n        searchRef.current?.focus()\n        return\n      }\n      const idx = selectedId ? flatIds.indexOf(selectedId) : -1\n      if (e.key === 'j' || e.key === 'ArrowDown') {\n        e.preventDefault()\n        setSelectedId(flatIds[Math.min(idx + 1, flatIds.length - 1)] ?? flatIds[0])\n      } else if (e.key === 'k' || e.key === 'ArrowUp') {\n        e.preventDefault()\n        setSelectedId(flatIds[Math.max(idx - 1, 0)] ?? flatIds[0])\n      }\n    }\n    window.addEventListener('keydown', onKeyDown)\n    return () =\u003e window.removeEventListener('keydown', onKeyDown)\n  }, [flatIds, selectedId])\n\n  const selectedRow = filtered.find((r) =\u003e r.id === selectedId)\n  const selectedGroup: GroupKey | undefined = selectedRow\n    ? (GROUP_ORDER.find((def) =\u003e (grouped.get(def.key) ?? []).some((r) =\u003e r.id === selectedRow.id))\n        ?.key)\n    : undefined\n\n  return (\n    \u003cdiv className=\"flex min-w-0 flex-1 flex-col\"\u003e\n      \u003cdiv className=\"border-border flex shrink-0 items-center gap-3 border-b px-4 py-3\"\u003e\n        \u003cdiv\u003e\n          \u003ch1 className=\"text-[15px] font-semibold\"\u003eMissions\u003c/h1\u003e\n          \u003cp className=\"text-text-faint text-[11.5px]\"\u003epunt-labs/ethos · main\u003c/p\u003e\n        \u003c/div\u003e\n\n        \u003cdiv className=\"border-border-strong ml-2 flex items-center rounded border p-0.5 text-[11.5px]\"\u003e\n          {VIEWS.map((v) =\u003e (\n            \u003cbutton\n              key={v}\n              onClick={() =\u003e setView(v)}\n              title={v === 'List' ? undefined : 'not built in this kit — List only'}\n              className={`rounded px-2 py-0.5 ${\n                v === view ? 'bg-elevated-2 text-text' : 'text-text-faint hover:text-text-muted'\n              }`}\n            \u003e\n              {v}\n            \u003c/button\u003e\n          ))}\n        \u003c/div\u003e\n\n        \u003cinput\n          ref={searchRef}\n          value={query}\n          onChange={(e) =\u003e setQuery(e.target.value)}\n          placeholder=\"Search missions, people, tickets… (press /)\"\n          className=\"border-border-strong bg-elevated placeholder:text-text-faint ml-auto w-72 rounded border px-2.5 py-1.5 text-[12.5px] outline-none focus:border-accent\"\n        /\u003e\n      \u003c/div\u003e\n\n      \u003cdiv className=\"flex min-h-0 flex-1\"\u003e\n        {view === 'List' ? (\n          \u003cdiv className=\"min-w-0 flex-1 overflow-y-auto\"\u003e\n            {GROUP_ORDER.map((def) =\u003e {\n              const groupItems = grouped.get(def.key) ?? []\n              if (groupItems.length === 0) return null\n              return (\n                \u003cdiv key={def.key}\u003e\n                  \u003cGroupHeader label={def.label} count={groupItems.length} /\u003e\n                  {groupItems.map((row) =\u003e (\n                    \u003cMissionRowView\n                      key={row.id}\n                      row={row}\n                      group={def.key}\n                      selected={row.id === selectedId}\n                      onSelect={() =\u003e setSelectedId(row.id)}\n                    /\u003e\n                  ))}\n                \u003c/div\u003e\n              )\n            })}\n            {filtered.length === 0 \u0026\u0026 (\n              \u003cp className=\"text-text-faint p-6 text-center text-[13px] italic\"\u003e\n                No missions match “{query}”.\n              \u003c/p\u003e\n            )}\n          \u003c/div\u003e\n        ) : (\n          \u003cdiv className=\"text-text-faint flex flex-1 items-center justify-center text-[13px] italic\"\u003e\n            {view} view is not built in this kit — List only.\n          \u003c/div\u003e\n        )}\n\n        {selectedRow \u0026\u0026 selectedGroup \u0026\u0026 (\n          \u003cdiv className=\"border-border bg-panel w-[440px] shrink-0 border-l\"\u003e\n            \u003cPeekPanel row={selectedRow} group={selectedGroup} /\u003e\n          \u003c/div\u003e\n        )}\n      \u003c/div\u003e\n    \u003c/div\u003e\n  )\n}\n","file_path":"~/Coding/punt-labs/desk/spike/ui/src/components/MissionsScreen.tsx"},"tool_input_hash":"c68e2dfc148ea0b4b3f152c58660cbb6b45ede9ed3b38475c060a2b30f0cecd1","tool_input_preview":"{\"content\":\"import { useEffect, useMemo, useRef, useState } from 'react'\\nimport { GROUP_ORDER, groupRows, type GroupKey } from '../lib/grouping'\\nimport { headline } from '../lib/format'\\nimport type..."}
