{"ts":"2026-09-11T05:45:17.148626845Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import { useEffect, useState } from 'react'\nimport './App.css'\nimport { fetchMissions } from './lib/api'\nimport { MissionsScreen } from './components/MissionsScreen'\nimport { Sidebar } from './components/Sidebar'\nimport { TopBar } from './components/TopBar'\nimport type { MissionSummary } from './types'\n\ntype LoadState =\n  | { status: 'loading' }\n  | { status: 'error'; message: string }\n  | { status: 'ready'; rows: MissionSummary[]; degraded: string[] }\n\nexport default function App() {\n  const [state, setState] = useState\u003cLoadState\u003e({ status: 'loading' })\n\n  useEffect(() =\u003e {\n    let cancelled = false\n    fetchMissions()\n      .then(({ missions, degraded }) =\u003e {\n        if (!cancelled) setState({ status: 'ready', rows: missions, degraded: degraded ?? [] })\n      })\n      .catch((err: unknown) =\u003e {\n        if (!cancelled) {\n          setState({ status: 'error', message: err instanceof Error ? err.message : String(err) })\n        }\n      })\n    return () =\u003e {\n      cancelled = true\n    }\n  }, [])\n\n  const missionCount = state.status === 'ready' ? state.rows.length : undefined\n  const degraded = state.status === 'ready' ? state.degraded : []\n\n  return (\n    \u003cdiv className=\"app-shell\"\u003e\n      \u003cTopBar /\u003e\n      \u003cdiv className=\"app-body\"\u003e\n        \u003cSidebar missionCount={missionCount} degraded={degraded} /\u003e\n        {state.status === 'loading' \u0026\u0026 \u003cdiv className=\"empty-state\"\u003eConnecting to deskd…\u003c/div\u003e}\n        {state.status === 'error' \u0026\u0026 (\n          \u003cdiv className=\"empty-state peek-error\"\u003eFailed to load missions: {state.message}\u003c/div\u003e\n        )}\n        {state.status === 'ready' \u0026\u0026 \u003cMissionsScreen rows={state.rows} /\u003e}\n      \u003c/div\u003e\n    \u003c/div\u003e\n  )\n}\n","file_path":"~/Coding/punt-labs/desk/apps/desk/src/App.tsx"},"tool_input_hash":"c4981071a3dc25539a1fc92264a66b6b64ff8c3296baa01d950ba52c300606f5","tool_input_preview":"{\"content\":\"import { useEffect, useState } from 'react'\\nimport './App.css'\\nimport { fetchMissions } from './lib/api'\\nimport { MissionsScreen } from './components/MissionsScreen'\\nimport { Sidebar }..."}
