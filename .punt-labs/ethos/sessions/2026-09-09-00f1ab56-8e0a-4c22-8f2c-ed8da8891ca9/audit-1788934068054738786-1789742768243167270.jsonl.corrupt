{"ts":"2026-09-11T04:19:35.251843854Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import findMissionsRaw from '../../fixtures/find-missions.jsonl?raw'\nimport listMissionsJson from '../../fixtures/mission-list.json'\nimport show0721001 from '../../fixtures/show-m-2026-07-21-001.json'\nimport log0721001 from '../../fixtures/log-m-2026-07-21-001.json'\nimport show0711004 from '../../fixtures/show-m-2026-07-11-004.json'\nimport log0711004 from '../../fixtures/log-m-2026-07-11-004.json'\nimport show0911007 from '../../fixtures/show-m-2026-09-11-007.json'\nimport log0911007 from '../../fixtures/log-m-2026-09-11-007.json'\nimport prompt0721001 from '../../fixtures/prompts/m-2026-07-21-001-d-2026-07-21-007-prompt.md?raw'\nimport prompt0822044 from '../../fixtures/prompts/m-2026-08-22-044-d-2026-08-22-093-prompt.md?raw'\n\nimport type {\n  FindMissionRecord,\n  ListMissionRecord,\n  MissionLog,\n  MissionRow,\n  MissionShow,\n} from '../types'\n\n// Captured `ethos mission show`/`log --json` fixtures. Only these three\n// missions get full-depth peek data (the ask, result prose, timeline) —\n// everywhere else the row's own fields (from `find`/`list`) are all the\n// UI has, matching what a first cut of a real backend would return before\n// every screen has a batch-detail endpoint.\nconst FULL_FIXTURES: Record\u003cstring, { show: MissionShow; log: MissionLog }\u003e = {\n  'm-2026-07-21-001': { show: show0721001 as MissionShow, log: log0721001 as MissionLog },\n  'm-2026-07-11-004': { show: show0711004 as MissionShow, log: log0711004 as MissionLog },\n  'm-2026-09-11-007': { show: show0911007 as MissionShow, log: log0911007 as MissionLog },\n}\n\n// Prompt.md is only captured for one delegation per mission, and only for\n// two missions total — real coverage, not a placeholder pattern.\nconst PROMPTS: Record\u003cstring, string\u003e = {\n  'm-2026-07-21-001': prompt0721001,\n  'm-2026-08-22-044': prompt0822044,\n}\n\nfunction parseFindMissions(): FindMissionRecord[] {\n  return findMissionsRaw\n    .split('\\n')\n    .filter((line) =\u003e line.trim().length \u003e 0)\n    .map((line) =\u003e JSON.parse(line) as FindMissionRecord)\n}\n\n/**\n * Merge the two real, only-partially-overlapping id sets `ethos find\n * missions` and `ethos mission list` return. `find` records are richer\n * (criteria, write_set, rounds) so they win when both exist; `list`-only\n * ids surface as genuinely thin rows — this is what the live data looks\n * like, not a fixture gap.\n */\nexport function loadMissionRows(): MissionRow[] {\n  const findRecords = parseFindMissions()\n  const listRecords = listMissionsJson as ListMissionRecord[]\n\n  const byId = new Map\u003cstring, MissionRow\u003e()\n\n  for (const r of findRecords) {\n    byId.set(r.id, {\n      id: r.id,\n      status: r.status,\n      type: r.type,\n      leader: r.leader,\n      worker: r.worker,\n      evaluator: r.evaluator,\n      ticket: r.ticket,\n      created_at: r.created_at,\n      closed_at: r.closed_at,\n      rounds_used: r.rounds_used,\n      rounds_budgeted: r.rounds_budgeted,\n      verdict: r.verdict,\n      success_criteria: r.success_criteria,\n      write_set: r.write_set,\n      source: 'find',\n    })\n  }\n\n  for (const r of listRecords) {\n    const existing = byId.get(r.mission_id)\n    if (existing) {\n      existing.source = 'find+list'\n      continue\n    }\n    byId.set(r.mission_id, {\n      id: r.mission_id,\n      status: r.status,\n      leader: r.leader,\n      worker: r.worker,\n      evaluator: r.evaluator,\n      created_at: r.created_at,\n      source: 'list',\n    })\n  }\n\n  // Live, in-progress mission from this very session isn't indexed by\n  // either read surface yet (both are point-in-time snapshots) — insert\n  // it directly from its `show` fixture so the \"Delegated\" group in this\n  // kit is populated by a real open mission rather than left empty.\n  if (!byId.has('m-2026-09-11-007')) {\n    const s = show0911007 as MissionShow\n    byId.set(s.mission_id, {\n      id: s.mission_id,\n      status: s.status,\n      type: s.type,\n      leader: s.leader,\n      worker: s.worker,\n      evaluator: s.evaluator?.handle,\n      ticket: s.inputs?.ticket,\n      created_at: s.created_at,\n      closed_at: s.closed_at,\n      rounds_used: s.current_round,\n      rounds_budgeted: s.budget?.rounds,\n      success_criteria: s.success_criteria,\n      write_set: s.write_set,\n      source: 'find',\n    })\n  }\n\n  for (const row of byId.values()) {\n    const fixture = FULL_FIXTURES[row.id]\n    if (fixture) {\n      row.full = fixture.show\n      row.log = fixture.log\n    }\n    const prompt = PROMPTS[row.id]\n    if (prompt) {\n      row.prompt = prompt\n    }\n  }\n\n  return Array.from(byId.values()).sort((a, b) =\u003e b.created_at.localeCompare(a.created_at))\n}\n","file_path":"~/Coding/punt-labs/desk/spike/ui/src/data/fixtures.ts"},"tool_input_hash":"81c1c17ec759031231dc38b95863908491bf19086dfab084468937b21486dbca","tool_input_preview":"{\"content\":\"import findMissionsRaw from '../../fixtures/find-missions.jsonl?raw'\\nimport listMissionsJson from '../../fixtures/mission-list.json'\\nimport show0721001 from '../../fixtures/show-m-2026-0..."}
