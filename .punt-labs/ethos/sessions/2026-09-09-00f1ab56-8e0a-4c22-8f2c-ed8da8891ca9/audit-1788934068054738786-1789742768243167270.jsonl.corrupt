{"ts":"2026-09-12T13:07:43.158634514Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-redesign-f17c7e06facedc5b","agent_type":"worker-redesign","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/apps/desk/src/lib/grouping.ts","new_string":"export interface DayGroup {\n  /** yyyy-mm-dd in the viewer's local zone, for a stable React key. */\n  key: string\n  label: string\n  rows: MissionSummary[]\n}\n\n/** Local (not UTC) calendar-day key for an ISO timestamp — bucketing and\n * row-date rendering (lib/format.ts formatDate) must agree on which zone\n * a timestamp belongs to, or a row can render one local day while its\n * group header claims another. */\nfunction localDayKey(iso: string): string {\n  const d = new Date(iso)\n  const y = d.getFullYear()\n  const m = String(d.getMonth() + 1).padStart(2, '0')\n  const day = String(d.getDate()).padStart(2, '0')\n  return `${y}-${m}-${day}`\n}\n\n/**\n * Default list scope (\"Recent\"): the `limit` most recently active missions\n * (by closed_at, else created_at), grouped by local calendar day and\n * ordered most-recent-first — everything else is left for the \"All\" pill\n * (groupRows/GROUP_ORDER, unchanged). Adaptive by mission count rather\n * than a fixed day window: a fixed 14-day cutoff against a store whose\n * real activity has gaps (verified live: only 1 of 155 missions fell in\n * the last 14 real days) collapses to a near-empty view; \"most recent N\"\n * always shows something as long as the store has anything in it.\n *\n * The day label is rendered from one of that bucket's own rows via the\n * same formatDate() the row itself uses (lib/format.ts) — not a\n * synthetic `${key}T00:00:00Z` reconstruction. That reconstruction was\n * the tz bug: local zones behind UTC (PDT, etc.) always read a UTC\n * midnight timestamp as the previous local day, so the header\n * permanently lagged the rows underneath it by one day regardless of\n * their actual local date.\n */\nexport function groupByDay(rows: MissionSummary[], limit = 30): DayGroup[] {\n  const dated = rows\n    .map((row) =\u003e ({ row, iso: row.closed_at ?? row.created_at }))\n    .filter((x): x is { row: MissionSummary; iso: string } =\u003e Boolean(x.iso))\n    .sort((a, b) =\u003e (a.iso \u003c b.iso ? 1 : a.iso \u003e b.iso ? -1 : 0))\n    .slice(0, limit)\n\n  const byDay = new Map\u003cstring, MissionSummary[]\u003e()\n  for (const { row, iso } of dated) {\n    const key = localDayKey(iso)\n    if (!byDay.has(key)) byDay.set(key, [])\n    byDay.get(key)!.push(row)\n  }\n  return [...byDay.keys()].sort((a, b) =\u003e (a \u003c b ? 1 : a \u003e b ? -1 : 0)).map((key) =\u003e {\n    const dayRows = byDay.get(key)!\n    return { key, label: formatDate((dayRows[0].closed_at ?? dayRows[0].created_at)!), rows: dayRows }\n  })\n}","old_string":"export interface DayGroup {\n  /** yyyy-mm-dd, for a stable React key. */\n  key: string\n  label: string\n  rows: MissionSummary[]\n}\n\n/**\n * Default list scope (\"Recent\"): missions with activity (closed_at, else\n * created_at) within the last `withinDays` days, grouped by day and\n * ordered most-recent-first — everything else is left for the \"All\" pill\n * (groupRows/GROUP_ORDER, unchanged). `now` is injectable for tests; the\n * real call site always uses the caller's wall clock.\n */\nexport function groupByDay(rows: MissionSummary[], withinDays = 14, now: Date = new Date()): DayGroup[] {\n  const cutoff = now.getTime() - withinDays * 24 * 60 * 60 * 1000\n  const byDay = new Map\u003cstring, MissionSummary[]\u003e()\n  for (const row of rows) {\n    const iso = row.closed_at ?? row.created_at\n    if (!iso) continue\n    if (new Date(iso).getTime() \u003c cutoff) continue\n    const key = iso.slice(0, 10)\n    if (!byDay.has(key)) byDay.set(key, [])\n    byDay.get(key)!.push(row)\n  }\n  return [...byDay.keys()]\n    .sort((a, b) =\u003e (a \u003c b ? 1 : a \u003e b ? -1 : 0))\n    .map((key) =\u003e ({ key, label: formatDate(`${key}T00:00:00Z`), rows: byDay.get(key)! }))\n}","replace_all":false},"tool_input_hash":"a3072869bd15ab4fe572fd68ea9b3e128d7c74e51028104cb4c0587aeef39eee","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/apps/desk/src/lib/grouping.ts\",\"new_string\":\"export interface DayGroup {\\n  /** yyyy-mm-dd in the viewer's local zone, for a stable React key. */\\n  key: string\\n..."}
