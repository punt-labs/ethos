{"ts":"2026-09-11T05:41:46.254212367Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/apps/desk/src/components/PeekPanel.tsx","new_string":"const TRACE_ONLY_REASON = 'trace-log record only — full mission record no longer in the store'\n\nexport function PeekPanel({ row, group }: { row: MissionSummary; group: GroupKey }) {\n  const state = useMissionDetail(row)\n  const contract = state.status === 'ready' ? state.detail.contract : undefined\n  const { text: title, derived } = contract ? detailHeadline(contract) : rowHeadline(row)\n  const events = state.status === 'ready' ? state.detail.log.events : undefined\n  const timeline = coarseTimeline(row, events)\n  const criteria = contract?.success_criteria ?? row.success_criteria\n\n  return (\n    \u003cdiv className=\"peek-panel\"\u003e\n      \u003cdiv className=\"peek-id\"\u003e{row.id}\u003c/div\u003e\n      \u003ch2 className={`peek-title ${derived ? '' : 'peek-title--faint'}`}\u003e{title}\u003c/h2\u003e\n\n      \u003cdiv className=\"peek-badges\"\u003e\n        \u003cBadge variant={badgeVariantForGroup(group)}\u003e\n          \u003cStatusGlyph group={group} /\u003e {group}\n        \u003c/Badge\u003e\n        {row.trace_only \u0026\u0026 \u003cBadge variant=\"neutral\"\u003etrace-log only\u003c/Badge\u003e}\n        {contract?.budget \u0026\u0026 (\n          \u003cBadge variant=\"neutral\"\u003e\n            round {contract.current_round ?? '?'} of {contract.budget.rounds}\n          \u003c/Badge\u003e\n        )}\n      \u003c/div\u003e\n\n      \u003cSectionLabel\u003eThe ask\u003c/SectionLabel\u003e\n      {state.status === 'loading' \u0026\u0026 \u003cp className=\"peek-loading\"\u003eloading…\u003c/p\u003e}\n      {state.status === 'error' \u0026\u0026 \u003cp className=\"peek-error\"\u003efailed to load: {state.message}\u003c/p\u003e}\n      {state.status === 'trace-only' \u0026\u0026 \u003cNotRecorded reason={TRACE_ONLY_REASON} /\u003e}\n      {state.status === 'ready' \u0026\u0026","old_string":"export function PeekPanel({ row, group }: { row: MissionSummary; group: GroupKey }) {\n  const state = useMissionDetail(row.id)\n  const contract = state.status === 'ready' ? state.detail.contract : undefined\n  const { text: title, derived } = contract ? detailHeadline(contract) : rowHeadline(row)\n  const events = state.status === 'ready' ? state.detail.log.events : undefined\n  const timeline = coarseTimeline(row, events)\n\n  return (\n    \u003cdiv className=\"peek-panel\"\u003e\n      \u003cdiv className=\"peek-id\"\u003e{row.id}\u003c/div\u003e\n      \u003ch2 className={`peek-title ${derived ? '' : 'peek-title--faint'}`}\u003e{title}\u003c/h2\u003e\n\n      \u003cdiv className=\"peek-badges\"\u003e\n        \u003cBadge variant={badgeVariantForGroup(group)}\u003e\n          \u003cStatusGlyph group={group} /\u003e {group}\n        \u003c/Badge\u003e\n        {contract?.budget \u0026\u0026 (\n          \u003cBadge variant=\"neutral\"\u003e\n            round {contract.current_round ?? '?'} of {contract.budget.rounds}\n          \u003c/Badge\u003e\n        )}\n      \u003c/div\u003e\n\n      \u003cSectionLabel\u003eThe ask\u003c/SectionLabel\u003e\n      {state.status === 'loading' \u0026\u0026 \u003cp className=\"peek-loading\"\u003eloading…\u003c/p\u003e}\n      {state.status === 'error' \u0026\u0026 \u003cp className=\"peek-error\"\u003efailed to load: {state.message}\u003c/p\u003e}\n      {state.status === 'ready' \u0026\u0026","replace_all":false},"tool_input_hash":"b781e7046df0d9478af1ecde9057ddd965a9a8002d446e182593425b60c6ec10","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/apps/desk/src/components/PeekPanel.tsx\",\"new_string\":\"const TRACE_ONLY_REASON = 'trace-log record only — full mission record no longer in the store'\\n\\nexport f..."}
