{"ts":"2026-09-11T04:20:22.403097008Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"// Initials for the handles that actually appear in this fixture set,\n// sourced from the org roster documented in the workspace CLAUDE.md.\n// Any handle not in this table (an unrecognized/future teammate) falls\n// back to its own first two letters — never a guess at a name.\nconst KNOWN_INITIALS: Record\u003cstring, string\u003e = {\n  claude: 'CL',\n  bwk: 'BK',\n  kpz: 'AK',\n  mdm: 'DM',\n  djb: 'DB',\n  adb: 'AB',\n  rmh: 'RH',\n  rsc: 'RC',\n  rop: 'RP',\n  dna: 'DN',\n  mcg: 'MC',\n  kth: 'KH',\n  jms: 'MS',\n  jra: 'JA',\n  bcs: 'BS',\n  edt: 'ET',\n  ghr: 'GR',\n  mal: 'MR',\n}\n\nexport function initialsFor(handle: string | undefined): string {\n  if (!handle) return '–'\n  return KNOWN_INITIALS[handle] ?? handle.slice(0, 2).toUpperCase()\n}\n\n// Deterministic accent per handle so the same person always gets the same\n// avatar color across a session, without a hardcoded per-name palette.\nconst AVATAR_HUES = [210, 265, 155, 25, 340, 190, 45, 300]\n\nexport function avatarHue(handle: string | undefined): number {\n  if (!handle) return 220\n  let hash = 0\n  for (let i = 0; i \u003c handle.length; i++) {\n    hash = (hash * 31 + handle.charCodeAt(i)) \u003e\u003e\u003e 0\n  }\n  return AVATAR_HUES[hash % AVATAR_HUES.length]\n}\n","file_path":"~/Coding/punt-labs/desk/spike/ui/src/lib/roster.ts"},"tool_input_hash":"be819fc0aa1fbf94a73bcda54f8c57118c960b9016b9aa33a17b42153792a11a","tool_input_preview":"{\"content\":\"// Initials for the handles that actually appear in this fixture set,\\n// sourced from the org roster documented in the workspace CLAUDE.md.\\n// Any handle not in this table (an unrecogniz..."}
