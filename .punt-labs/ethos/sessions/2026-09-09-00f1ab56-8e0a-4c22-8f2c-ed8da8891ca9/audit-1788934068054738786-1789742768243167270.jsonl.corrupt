{"ts":"2026-09-11T05:13:37.297233421Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import type { MissionContract, MissionSummary, Verdict } from '../types'\n\n/** \"m-2026-07-21-001\" -\u003e \"m-…-07-21-001\" — collapses the year so the\n * month/day/sequence (the part that actually distinguishes ids at a\n * glance) gets the space. */\nexport function shortId(id: string): string {\n  return id.replace(/^m-\\d{4}-/, 'm-…-')\n}\n\nexport function truncate(text: string, max: number): string {\n  const clean = text.trim().replace(/\\s+/g, ' ')\n  if (clean.length \u003c= max) return clean\n  return clean.slice(0, max - 1).trimEnd() + '…'\n}\n\n/**\n * List-row headline. `GET /api/missions` carries no description field at\n * all (deskd's missionSummary has id/status/type/leader/worker/evaluator/\n * ticket/created_at/closed_at/verdict only — verified live, not assumed);\n * success_criteria/context only exist on the per-mission detail endpoint,\n * which is not worth an N+1 fetch just to populate a list label. So the\n * row headline is honestly derived from type+ticket, not a real title.\n */\nexport function rowHeadline(row: MissionSummary): { text: string; derived: boolean } {\n  if (row.ticket) return { text: `${row.type ?? 'mission'} · ${row.ticket}`, derived: true }\n  if (row.type) return { text: row.type, derived: true }\n  return { text: '(no description recorded)', derived: false }\n}\n\n/**\n * Peek-panel headline, once the full contract has loaded. Same \"no title\n * field anywhere\" gap as the row, but here success_criteria/context are\n * available so a genuine sentence can usually be pulled out.\n */\nexport function detailHeadline(contract: MissionContract): { text: string; derived: boolean } {\n  const firstCriterion = contract.success_criteria?.[0]\n  if (firstCriterion) {\n    // Some criteria are one giant run-on paragraph rather than a short\n    // item. Prefer the first sentence when a hard character cut would\n    // land mid-clause.\n    if (firstCriterion.length \u003e 100) {\n      const sentenceEnd = firstCriterion.slice(0, 140).search(/[.!?]\\s/)\n      if (sentenceEnd \u003e 20) {\n        return { text: firstCriterion.slice(0, sentenceEnd + 1), derived: true }\n      }\n    }\n    return { text: truncate(firstCriterion, 100), derived: true }\n  }\n  if (contract.context) return { text: truncate(contract.context, 100), derived: true }\n  if (contract.inputs?.ticket) {\n    return { text: `${contract.type ?? 'mission'} · ${contract.inputs.ticket}`, derived: true }\n  }\n  return { text: '(no description recorded)', derived: false }\n}\n\nexport function verdictVariant(verdict: Verdict | string | undefined): 'pass' | 'fail' | 'warn' | 'neutral' {\n  switch (verdict) {\n    case 'pass':\n      return 'pass'\n    case 'fail':\n      return 'fail'\n    case 'escalate':\n      return 'warn'\n    default:\n      return 'neutral'\n  }\n}\n\nexport function formatDate(iso: string): string {\n  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })\n}\n\nexport function formatDateTime(iso: string): string {\n  return new Date(iso).toLocaleString('en-US', {\n    month: 'short',\n    day: 'numeric',\n    hour: '2-digit',\n    minute: '2-digit',\n    hour12: false,\n  })\n}\n\nexport function formatClock(iso: string): string {\n  return new Date(iso).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', hour12: false })\n}\n","file_path":"~/Coding/punt-labs/desk/apps/desk/src/lib/format.ts"},"tool_input_hash":"cfbb3ff4aaf8681224f8c9c9439b7374d58b05cd5378230c685045bf9e50c794","tool_input_preview":"{\"content\":\"import type { MissionContract, MissionSummary, Verdict } from '../types'\\n\\n/** \\\"m-2026-07-21-001\\\" -\\u003e \\\"m-…-07-21-001\\\" — collapses the year so the\\n * month/day/sequence (the p..."}
{"ts":"2026-09-11T05:13:50.378277047Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import type { MissionSummary } from '../types'\n\nexport type GroupKey = 'delegated' | 'reflecting' | 'closed' | 'failed' | 'escalated' | 'abandoned'\n\nexport interface GroupDef {\n  key: GroupKey\n  label: string\n}\n\n// Order mirrors the visual spec: work-in-progress first, terminal states\n// after. `delegated`/`reflecting` are derived open-mission substates; the\n// rest map 1:1 onto the mission's own `status` field.\nexport const GROUP_ORDER: GroupDef[] = [\n  { key: 'delegated', label: 'Delegated' },\n  { key: 'reflecting', label: 'Reflecting' },\n  { key: 'closed', label: 'Closed' },\n  { key: 'failed', label: 'Failed' },\n  { key: 'escalated', label: 'Escalated' },\n  { key: 'abandoned', label: 'Abandoned' },\n]\n\n/**\n * `GET /api/missions` carries no round/result info for an `open` mission\n * (deskd's missionSummary is deliberately thin — see types.ts), so there\n * is no cheap way to tell \"delegated\" (no result yet) from \"reflecting\"\n * (result landed, leader hasn't advanced) without an extra per-row detail\n * fetch. Every open row defaults to \"delegated\" — the more common case —\n * and this is a stated assumption, not a hidden one. In the live ethos\n * repo dataset this daemon serves, no mission is currently `open` at all\n * (statuses observed: closed/failed/abandoned/escalated only), so neither\n * bucket has ever been exercised with real data through this API.\n */\nexport function groupFor(row: MissionSummary): GroupKey {\n  switch (row.status) {\n    case 'closed':\n      return 'closed'\n    case 'failed':\n      return 'failed'\n    case 'escalated':\n      return 'escalated'\n    case 'abandoned':\n      return 'abandoned'\n    default:\n      return 'delegated'\n  }\n}\n\nexport function groupRows(rows: MissionSummary[]): Map\u003cGroupKey, MissionSummary[]\u003e {\n  const map = new Map\u003cGroupKey, MissionSummary[]\u003e()\n  for (const def of GROUP_ORDER) map.set(def.key, [])\n  for (const row of rows) {\n    map.get(groupFor(row))!.push(row)\n  }\n  return map\n}\n","file_path":"~/Coding/punt-labs/desk/apps/desk/src/lib/grouping.ts"},"tool_input_hash":"85dac20de9087cacf93a3d6b04b11396f873e5378dd66cab5fddc21c2ebe5211","tool_input_preview":"{\"content\":\"import type { MissionSummary } from '../types'\\n\\nexport type GroupKey = 'delegated' | 'reflecting' | 'closed' | 'failed' | 'escalated' | 'abandoned'\\n\\nexport interface GroupDef {\\n  key:..."}
{"ts":"2026-09-11T05:14:08.649216508Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"import type { LogEvent, MissionSummary } from '../types'\n\nexport interface TimelinePoint {\n  ts: string\n  label: string\n  actor?: string\n  variant: 'neutral' | 'pass' | 'fail' | 'warn' | 'info'\n}\n\nfunction describeEvent(e: LogEvent): TimelinePoint {\n  const d = e.details ?? {}\n  switch (e.event) {\n    case 'create':\n      return { ts: e.ts, label: 'mission created', actor: e.actor, variant: 'neutral' }\n    case 'reflect':\n      return {\n        ts: e.ts,\n        label: `reflection recorded · round ${d.round ?? '?'} · ${d.recommendation ?? 'unknown'}`,\n        actor: e.actor,\n        variant: 'warn',\n      }\n    case 'round_advanced':\n      return {\n        ts: e.ts,\n        label: `round advanced ${d.from_round ?? '?'} → ${d.to_round ?? '?'}`,\n        actor: e.actor,\n        variant: 'info',\n      }\n    case 'result': {\n      const verdict = d.verdict as string | undefined\n      return {\n        ts: e.ts,\n        label: `result submitted · round ${d.round ?? '?'} · ${verdict ?? 'unknown'}`,\n        actor: e.actor,\n        variant: verdict === 'pass' ? 'pass' : verdict === 'fail' ? 'fail' : 'neutral',\n      }\n    }\n    case 'close': {\n      const status = d.status as string | undefined\n      return {\n        ts: e.ts,\n        label: `mission closed · ${status ?? 'unknown'}`,\n        actor: e.actor,\n        variant: status === 'closed' ? 'pass' : 'fail',\n      }\n    }\n    default:\n      return { ts: e.ts, label: e.event, actor: e.actor, variant: 'neutral' }\n  }\n}\n\n/**\n * Coarse, honest timeline: 2-3 checkpoints, never a padded fabrication.\n * With a real log, collapse to first event + last result (if any) + close\n * (if any). Without one — the detail fetch failed, or is still in\n * flight — fall back to the two real timestamps the list row already\n * carries (created_at, closed_at).\n */\nexport function coarseTimeline(\n  row: MissionSummary,\n  events?: LogEvent[],\n): { points: TimelinePoint[]; source: 'log' | 'record' | 'none' } {\n  if (events \u0026\u0026 events.length \u003e 0) {\n    const points: TimelinePoint[] = [describeEvent(events[0])]\n    const lastResult = [...events].reverse().find((e) =\u003e e.event === 'result')\n    if (lastResult \u0026\u0026 lastResult !== events[0]) points.push(describeEvent(lastResult))\n    const closeEvent = events.find((e) =\u003e e.event === 'close')\n    if (closeEvent) points.push(describeEvent(closeEvent))\n    return { points, source: 'log' }\n  }\n\n  if (!row.created_at) return { points: [], source: 'none' }\n  const points: TimelinePoint[] = [\n    { ts: row.created_at, label: 'mission created', actor: row.leader, variant: 'neutral' },\n  ]\n  if (row.closed_at) {\n    points.push({\n      ts: row.closed_at,\n      label: `mission ${row.status}`,\n      variant: row.status === 'closed' ? 'pass' : row.status === 'failed' ? 'fail' : 'neutral',\n    })\n  }\n  return { points, source: row.closed_at ? 'record' : 'none' }\n}\n","file_path":"~/Coding/punt-labs/desk/apps/desk/src/lib/timeline.ts"},"tool_input_hash":"88956feeadb17345839111d01d054e18b7c1ce647aa847cfdee3ed0c084d60ba","tool_input_preview":"{\"content\":\"import type { LogEvent, MissionSummary } from '../types'\\n\\nexport interface TimelinePoint {\\n  ts: string\\n  label: string\\n  actor?: string\\n  variant: 'neutral' | 'pass' | 'fail' | 'war..."}
{"ts":"2026-09-11T05:15:01.872939637Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Write","tool_input":{"content":"/* Design tokens — same palette validated in spike/ui/src/index.css. Plain\n   CSS rather than Tailwind: adding a build-time CSS framework here would\n   require touching vite.config.ts/package.json, both outside this\n   mission's write set (apps/desk/src/**). */\n:root {\n  --font-sans:\n    'Inter', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;\n  --font-mono: 'SF Mono', ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace;\n\n  --ground: #08090a;\n  --panel: #0c0d0f;\n  --elevated: #131418;\n  --elevated-2: #17181d;\n  --border: #1e1f24;\n  --border-strong: #2a2b32;\n\n  --text: #e7e8ea;\n  --text-muted: #8a8f98;\n  --text-faint: #55585f;\n\n  --accent: #5e6ad2;\n  --accent-soft: rgba(94, 106, 210, 0.12);\n  --accent-border: rgba(94, 106, 210, 0.3);\n\n  --pass: #4cb782;\n  --pass-soft: rgba(76, 183, 130, 0.13);\n  --fail: #eb5757;\n  --fail-soft: rgba(235, 87, 87, 0.13);\n  --warn: #e2b203;\n  --warn-soft: rgba(226, 178, 3, 0.13);\n  --info: #4ea7fc;\n  --info-soft: rgba(78, 167, 252, 0.13);\n}\n\n* {\n  box-sizing: border-box;\n}\n\nhtml,\nbody,\n#root {\n  height: 100%;\n}\n\nbody {\n  margin: 0;\n  background: var(--ground);\n  color: var(--text);\n  font-family: var(--font-sans);\n  font-size: 13px;\n  -webkit-font-smoothing: antialiased;\n}\n\nbutton,\ninput {\n  font: inherit;\n  color: inherit;\n}\n\n/* ---------- App shell ---------- */\n\n.app-shell {\n  display: flex;\n  flex-direction: column;\n  height: 100vh;\n}\n\n.app-body {\n  display: flex;\n  min-height: 0;\n  flex: 1;\n}\n\n/* ---------- Top bar ---------- */\n\n.topbar {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  height: 52px;\n  flex-shrink: 0;\n  padding: 0 1rem;\n  background: var(--panel);\n  border-bottom: 1px solid var(--border);\n}\n\n.topbar-title {\n  display: flex;\n  align-items: baseline;\n  gap: 0.5rem;\n}\n\n.topbar-title strong {\n  font-size: 14px;\n  font-weight: 600;\n}\n\n.topbar-subtitle {\n  color: var(--text-faint);\n  font-size: 11.5px;\n}\n\n.topbar-tabs {\n  display: flex;\n  align-items: center;\n  gap: 0.25rem;\n  margin-left: auto;\n}\n\n.topbar-tab {\n  padding: 0.25rem 0.625rem;\n  border-radius: 4px;\n  font-size: 12.5px;\n  color: var(--text-faint);\n  cursor: not-allowed;\n}\n\n.topbar-tab--active {\n  background: var(--elevated-2);\n  color: var(--text);\n  font-weight: 500;\n  cursor: default;\n}\n\n/* ---------- Sidebar ---------- */\n\n.sidebar {\n  display: flex;\n  flex-direction: column;\n  width: 224px;\n  flex-shrink: 0;\n  background: var(--panel);\n  border-right: 1px solid var(--border);\n}\n\n.sidebar-repo-wrap {\n  padding: 0.75rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.sidebar-repo {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  width: 100%;\n  padding: 0.375rem 0.625rem;\n  background: var(--elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 4px;\n  font-size: 13px;\n  text-align: left;\n}\n\n.sidebar-repo-dot {\n  width: 6px;\n  height: 6px;\n  border-radius: 999px;\n  background: var(--pass);\n}\n\n.sidebar-repo-name {\n  flex: 1;\n}\n\n.sidebar-repo-caret {\n  color: var(--text-faint);\n  font-size: 10px;\n}\n\n.sidebar-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  padding: 0.5rem;\n}\n\n.sidebar-nav-item {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.375rem 0.625rem;\n  border-radius: 4px;\n  font-size: 13px;\n  color: var(--text-muted);\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.sidebar-nav-item--active {\n  background: var(--accent-soft);\n  color: var(--text);\n  font-weight: 500;\n  opacity: 1;\n  cursor: default;\n  border-left: 2px solid var(--accent);\n  padding-left: calc(0.625rem - 2px);\n}\n\n.sidebar-nav-label {\n  flex: 1;\n}\n\n.sidebar-nav-count {\n  color: var(--text-faint);\n  font-size: 11px;\n}\n\n.sidebar-footer {\n  margin-top: auto;\n  padding: 0.75rem;\n}\n\n.sidebar-footer p {\n  margin: 0;\n  color: var(--text-faint);\n  font-size: 10.5px;\n  font-style: italic;\n  line-height: 1.5;\n}\n\n/* ---------- Missions screen ---------- */\n\n.missions-screen {\n  display: flex;\n  flex-direction: column;\n  flex: 1;\n  min-width: 0;\n}\n\n.missions-header {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-shrink: 0;\n  padding: 0.75rem 1rem;\n  border-bottom: 1px solid var(--border);\n}\n\n.missions-title {\n  margin: 0;\n  font-size: 15px;\n  font-weight: 600;\n}\n\n.missions-breadcrumb {\n  margin: 0;\n  color: var(--text-faint);\n  font-size: 11.5px;\n}\n\n.view-switch {\n  display: flex;\n  align-items: center;\n  gap: 1px;\n  margin-left: 0.5rem;\n  padding: 2px;\n  border: 1px solid var(--border-strong);\n  border-radius: 4px;\n  font-size: 11.5px;\n}\n\n.view-switch-btn {\n  padding: 0.125rem 0.5rem;\n  border-radius: 3px;\n  border: none;\n  background: none;\n  color: var(--text-faint);\n  cursor: pointer;\n}\n\n.view-switch-btn:hover {\n  color: var(--text-muted);\n}\n\n.view-switch-btn--active {\n  background: var(--elevated-2);\n  color: var(--text);\n}\n\n.search-input {\n  margin-left: auto;\n  width: 288px;\n  padding: 0.375rem 0.625rem;\n  background: var(--elevated);\n  border: 1px solid var(--border-strong);\n  border-radius: 4px;\n  font-size: 12.5px;\n  outline: none;\n}\n\n.search-input:focus {\n  border-color: var(--accent);\n}\n\n.search-input::placeholder {\n  color: var(--text-faint);\n}\n\n.screen-body {\n  display: flex;\n  min-height: 0;\n  flex: 1;\n}\n\n.list-pane {\n  flex: 1;\n  min-width: 0;\n  overflow-y: auto;\n}\n\n.empty-state {\n  padding: 1.5rem;\n  text-align: center;\n  color: var(--text-faint);\n  font-size: 13px;\n  font-style: italic;\n}\n\n/* ---------- Group header ---------- */\n\n.group-header {\n  position: sticky;\n  top: 0;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.375rem 0.75rem;\n  background: rgba(12, 13, 15, 0.95);\n  backdrop-filter: blur(4px);\n  border-bottom: 1px solid var(--border);\n}\n\n.group-header-label {\n  color: var(--text-muted);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n}\n\n.group-header-count {\n  color: var(--text-faint);\n  font-size: 11px;\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- Mission row ---------- */\n\n.mission-row {\n  display: flex;\n  align-items: center;\n  gap: 0.625rem;\n  height: 36px;\n  padding: 0 0.75rem;\n  border-bottom: 1px solid rgba(30, 31, 36, 0.6);\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.mission-row:hover {\n  background: var(--elevated);\n}\n\n.mission-row--selected {\n  background: rgba(94, 106, 210, 0.12);\n  border-left: 2px solid var(--accent);\n  padding-left: calc(0.75rem - 2px);\n}\n\n.mission-row-id {\n  width: 108px;\n  flex-shrink: 0;\n  color: var(--text-faint);\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.mission-row-title {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.mission-row-title--faint {\n  color: var(--text-faint);\n  font-style: italic;\n}\n\n.mission-row-date {\n  width: 56px;\n  flex-shrink: 0;\n  text-align: right;\n  color: var(--text-faint);\n  font-size: 11px;\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n}\n\n/* ---------- Status glyph ---------- */\n\n.status-glyph {\n  display: inline-flex;\n  width: 16px;\n  flex-shrink: 0;\n  justify-content: center;\n  font-family: var(--font-mono);\n  font-size: 13px;\n}\n\n.status-glyph--info {\n  color: var(--info);\n}\n.status-glyph--warn {\n  color: var(--warn);\n}\n.status-glyph--pass {\n  color: var(--pass);\n}\n.status-glyph--fail {\n  color: var(--fail);\n}\n.status-glyph--faint {\n  color: var(--text-faint);\n}\n\n/* ---------- Avatar ---------- */\n\n.avatar {\n  display: inline-flex;\n  flex-shrink: 0;\n  align-items: center;\n  justify-content: center;\n  border-radius: 999px;\n  font-family: var(--font-mono);\n  font-weight: 600;\n  font-size: 10px;\n  line-height: 1;\n}\n\n/* ---------- Badge ---------- */\n\n.badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n  padding: 0.125rem 0.375rem;\n  border-radius: 4px;\n  font-size: 11px;\n  font-weight: 500;\n  line-height: 1;\n  white-space: nowrap;\n}\n\n.badge--pass {\n  background: var(--pass-soft);\n  color: var(--pass);\n}\n.badge--fail {\n  background: var(--fail-soft);\n  color: var(--fail);\n}\n.badge--warn {\n  background: var(--warn-soft);\n  color: var(--warn);\n}\n.badge--info {\n  background: var(--info-soft);\n  color: var(--info);\n}\n.badge--neutral {\n  background: var(--elevated-2);\n  color: var(--text-muted);\n}\n.badge--accent {\n  background: var(--accent-soft);\n  color: var(--accent);\n}\n\n/* ---------- Peek panel ---------- */\n\n.peek-panel {\n  width: 440px;\n  flex-shrink: 0;\n  background: var(--panel);\n  border-left: 1px solid var(--border);\n  overflow-y: auto;\n  padding: 1.25rem;\n}\n\n.peek-id {\n  margin-bottom: 0.375rem;\n  color: var(--text-faint);\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.peek-title {\n  margin: 0;\n  font-size: 17px;\n  font-weight: 600;\n  line-height: 1.35;\n}\n\n.peek-title--faint {\n  color: var(--text-faint);\n  font-style: italic;\n  font-weight: 400;\n}\n\n.peek-badges {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.375rem;\n  margin-top: 0.75rem;\n}\n\n.section-label {\n  margin: 1.25rem 0 0.5rem;\n  color: var(--text-faint);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n}\n\n.section-label:first-of-type {\n  margin-top: 0;\n}\n\n.quote-block {\n  padding: 0.5rem 0.5rem 0.5rem 0.75rem;\n  background: var(--elevated);\n  border-left: 2px solid var(--border-strong);\n  border-radius: 0 4px 4px 0;\n}\n\n.quote-block--ask {\n  border-left-color: var(--accent-border);\n}\n\n.quote-meta {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  margin-bottom: 0.375rem;\n  color: var(--text-muted);\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.quote-meta-note {\n  margin-bottom: 0.375rem;\n  color: var(--text-faint);\n  font-size: 11px;\n  font-style: italic;\n}\n\n.quote-body {\n  margin: 0;\n  color: var(--text);\n  font-size: 12.5px;\n  line-height: 1.6;\n  white-space: pre-wrap;\n}\n\n.result-card {\n  padding: 0.5rem 0.5rem 0.5rem 0.75rem;\n  background: var(--elevated);\n  border-left: 2px solid var(--border-strong);\n  border-radius: 0 4px 4px 0;\n}\n\n.result-card + .result-card {\n  margin-top: 0.75rem;\n}\n\n.result-cards {\n  display: flex;\n  flex-direction: column;\n}\n\n.result-meta {\n  display: flex;\n  align-items: center;\n  gap: 0.375rem;\n  margin-bottom: 0.375rem;\n  font-family: var(--font-mono);\n  font-size: 11px;\n}\n\n.result-author {\n  color: var(--text-muted);\n}\n\n.result-round,\n.result-confidence {\n  color: var(--text-faint);\n}\n\n.result-confidence {\n  margin-left: auto;\n}\n\n.result-prose {\n  margin: 0 0 0.5rem;\n  color: var(--text);\n  font-size: 12.5px;\n  line-height: 1.6;\n  white-space: pre-wrap;\n}\n\n.evidence-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  margin: 0 0 0.5rem;\n  padding: 0;\n  list-style: none;\n}\n\n.evidence-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.375rem;\n  font-size: 12px;\n}\n\n.evidence-item--pass .evidence-glyph {\n  color: var(--pass);\n}\n.evidence-item--fail .evidence-glyph {\n  color: var(--fail);\n}\n\n.evidence-name {\n  color: var(--text-muted);\n}\n\n.open-questions {\n  padding: 0.5rem 0.625rem;\n  background: var(--warn-soft);\n  border: 1px solid rgba(226, 178, 3, 0.4);\n  border-radius: 4px;\n}\n\n.open-questions-title {\n  margin-bottom: 0.25rem;\n  color: var(--warn);\n  font-size: 10.5px;\n  font-weight: 600;\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n}\n\n.open-questions-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.open-questions-list li {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.375rem;\n  color: var(--text-muted);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.open-questions-list li::before {\n  content: '?';\n  color: var(--warn);\n}\n\n.criteria-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.375rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.criteria-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.375rem;\n  color: var(--text-muted);\n  font-size: 12.5px;\n  line-height: 1.6;\n}\n\n.criteria-item::before {\n  content: '–';\n  margin-top: 1px;\n  color: var(--text-faint);\n}\n\n.timeline-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.timeline-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 0.5rem;\n  font-size: 12px;\n}\n\n.timeline-time {\n  width: 48px;\n  flex-shrink: 0;\n  padding-top: 2px;\n  color: var(--text-faint);\n  font-family: var(--font-mono);\n  white-space: nowrap;\n}\n\n.timeline-dot-wrap {\n  padding-top: 4px;\n}\n\n.timeline-dot {\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 999px;\n}\n\n.timeline-dot--neutral {\n  background: var(--text-faint);\n}\n.timeline-dot--pass {\n  background: var(--pass);\n}\n.timeline-dot--fail {\n  background: var(--fail);\n}\n.timeline-dot--warn {\n  background: var(--warn);\n}\n.timeline-dot--info {\n  background: var(--info);\n}\n\n.timeline-label {\n  color: var(--text-muted);\n}\n\n.timeline-actor {\n  color: var(--text-faint);\n}\n\n.not-recorded {\n  padding: 0.5rem 0.625rem;\n  border: 1px dashed var(--border-strong);\n  border-radius: 4px;\n  color: var(--text-faint);\n  font-size: 12px;\n  font-style: italic;\n}\n\n.mechanics {\n  margin-top: 1.25rem;\n  padding-top: 0.75rem;\n  border-top: 1px solid var(--border);\n}\n\n.mechanics-summary {\n  color: var(--text-faint);\n  font-size: 11px;\n  font-weight: 600;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  cursor: pointer;\n  user-select: none;\n}\n\n.mechanics-grid {\n  display: grid;\n  grid-template-columns: auto 1fr;\n  gap: 0.375rem 0.75rem;\n  margin-top: 0.625rem;\n  font-size: 12px;\n}\n\n.mechanics-dt {\n  color: var(--text-faint);\n  white-space: nowrap;\n}\n\n.mechanics-dd {\n  margin: 0;\n  color: var(--text-muted);\n  font-family: var(--font-mono);\n  overflow-wrap: anywhere;\n}\n\n.mechanics-hash {\n  color: var(--text-faint);\n  font-size: 10.5px;\n  overflow-wrap: anywhere;\n}\n\n.write-set-list {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.write-set-list li {\n  color: var(--text-muted);\n  font-family: var(--font-mono);\n  font-size: 11px;\n  overflow-wrap: anywhere;\n}\n\n.peek-loading,\n.peek-error {\n  padding: 0.5rem 0;\n  color: var(--text-faint);\n  font-size: 12.5px;\n  font-style: italic;\n}\n\n.peek-error {\n  color: var(--fail);\n}\n","file_path":"~/Coding/punt-labs/desk/apps/desk/src/App.css"},"tool_input_hash":"cdaa09897856ddc70e9ff8cdbe4ca3e405dd2b913adb218f12ee988677d23994","tool_input_preview":"{\"content\":\"/* Design tokens — same palette validated in spike/ui/src/index.css. Plain\\n   CSS rather than Tailwind: adding a build-time CSS framework here would\\n   require touching vite.config.ts/..."}
