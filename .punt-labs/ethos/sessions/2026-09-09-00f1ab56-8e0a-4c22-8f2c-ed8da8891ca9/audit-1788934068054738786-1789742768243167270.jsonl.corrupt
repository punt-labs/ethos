{"ts":"2026-09-11T04:15:17.682388546Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-deskd-8cc8192e6dcc72db","agent_type":"worker-deskd","tool":"Write","tool_input":{"content":"package main\n\nimport (\n\t\"errors\"\n\t\"fmt\"\n\t\"os\"\n\t\"path/filepath\"\n\t\"sort\"\n)\n\n// promptExcerptLen bounds how much of each delegation's prompt.md is\n// returned in the mission detail response; full prompts can be long and\n// the UI only needs enough to identify what was asked.\nconst promptExcerptLen = 500\n\ntype delegationInfo struct {\n\tID            string `json:\"id\"`\n\tPromptExcerpt string `json:\"prompt_excerpt,omitempty\"`\n}\n\n// readMissionFS reads the two pieces of a mission that the ethos CLI does\n// not expose: per-delegation prompts and the artifacts directory listing.\n// Both live under \u003crepo\u003e/.punt-labs/ethos/missions/\u003cid\u003e/.\nfunc (s *server) readMissionFS(id string) ([]delegationInfo, []string, error) {\n\tbase := filepath.Join(s.repo, \".punt-labs\", \"ethos\", \"missions\", id)\n\n\tdelegations, err := listDelegations(filepath.Join(base, \"delegations\"))\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tartifacts, err := listArtifacts(filepath.Join(base, \"artifacts\"))\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn delegations, artifacts, nil\n}\n\nfunc listDelegations(dir string) ([]delegationInfo, error) {\n\tentries, err := os.ReadDir(dir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn []delegationInfo{}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"reading delegations dir %s: %w\", dir, err)\n\t}\n\n\tout := make([]delegationInfo, 0, len(entries))\n\tfor _, e := range entries {\n\t\tif !e.IsDir() {\n\t\t\tcontinue\n\t\t}\n\t\tpromptPath := filepath.Join(dir, e.Name(), \"prompt.md\")\n\t\tdata, err := os.ReadFile(promptPath)\n\t\tswitch {\n\t\tcase errors.Is(err, os.ErrNotExist):\n\t\t\tout = append(out, delegationInfo{ID: e.Name()})\n\t\tcase err != nil:\n\t\t\treturn nil, fmt.Errorf(\"reading prompt %s: %w\", promptPath, err)\n\t\tdefault:\n\t\t\tout = append(out, delegationInfo{ID: e.Name(), PromptExcerpt: excerpt(string(data), promptExcerptLen)})\n\t\t}\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].ID \u003c out[j].ID })\n\treturn out, nil\n}\n\nfunc listArtifacts(dir string) ([]string, error) {\n\tentries, err := os.ReadDir(dir)\n\tif errors.Is(err, os.ErrNotExist) {\n\t\treturn []string{}, nil\n\t}\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"reading artifacts dir %s: %w\", dir, err)\n\t}\n\n\tnames := make([]string, 0, len(entries))\n\tfor _, e := range entries {\n\t\tnames = append(names, e.Name())\n\t}\n\tsort.Strings(names)\n\treturn names, nil\n}\n\nfunc excerpt(s string, n int) string {\n\tif len(s) \u003c= n {\n\t\treturn s\n\t}\n\treturn s[:n] + \"…\"\n}\n","file_path":"~/Coding/punt-labs/desk/spike/deskd/fs.go"},"tool_input_hash":"93795dee80adb3399e1307b3ce235060a23f3d2b6f5f9fb0f93e2ea6183f5eaf","tool_input_preview":"{\"content\":\"package main\\n\\nimport (\\n\\t\\\"errors\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"os\\\"\\n\\t\\\"path/filepath\\\"\\n\\t\\\"sort\\\"\\n)\\n\\n// promptExcerptLen bounds how much of each delegation's prompt.md is\\n// returned in the..."}
