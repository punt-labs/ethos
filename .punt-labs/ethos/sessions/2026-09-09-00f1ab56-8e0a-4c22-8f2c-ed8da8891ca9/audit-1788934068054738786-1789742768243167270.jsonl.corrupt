{"ts":"2026-09-11T04:15:39.933908544Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-deskd-8cc8192e6dcc72db","agent_type":"worker-deskd","tool":"Write","tool_input":{"content":"package main\n\nimport (\n\t\"bytes\"\n\t\"context\"\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"net/http\"\n\t\"sort\"\n)\n\n// traceSummary is one line of `ethos find missions --format json`: the\n// closed-mission trace log, keyed \"id\".\ntype traceSummary struct {\n\tID        string `json:\"id\"`\n\tCreatedAt string `json:\"created_at\"`\n\tClosedAt  string `json:\"closed_at\"`\n\tStatus    string `json:\"status\"`\n\tType      string `json:\"type\"`\n\tLeader    string `json:\"leader\"`\n\tWorker    string `json:\"worker\"`\n\tEvaluator string `json:\"evaluator\"`\n\tTicket    string `json:\"ticket\"`\n\tVerdict   string `json:\"verdict\"`\n}\n\n// listEntry is one element of `ethos mission list --json --status all`:\n// a thin summary of every mission regardless of status, keyed\n// \"mission_id\".\ntype listEntry struct {\n\tMissionID string `json:\"mission_id\"`\n\tStatus    string `json:\"status\"`\n\tLeader    string `json:\"leader\"`\n\tWorker    string `json:\"worker\"`\n\tEvaluator string `json:\"evaluator\"`\n\tCreatedAt string `json:\"created_at\"`\n}\n\n// contract is the subset of `ethos mission show --json` needed to enrich\n// a listEntry that find-missions doesn't know about yet (an open mission,\n// or one closed after the trace log fell out of sync).\ntype contract struct {\n\tMissionID string `json:\"mission_id\"`\n\tStatus    string `json:\"status\"`\n\tType      string `json:\"type\"`\n\tCreatedAt string `json:\"created_at\"`\n\tClosedAt  string `json:\"closed_at\"`\n\tLeader    string `json:\"leader\"`\n\tWorker    string `json:\"worker\"`\n\tEvaluator struct {\n\t\tHandle string `json:\"handle\"`\n\t} `json:\"evaluator\"`\n\tInputs struct {\n\t\tTicket string `json:\"ticket\"`\n\t} `json:\"inputs\"`\n\tResults []struct {\n\t\tVerdict string `json:\"verdict\"`\n\t} `json:\"results\"`\n}\n\n// missionSummary is deskd's normalized shape for GET /api/missions,\n// merging traceSummary and listEntry/contract under one id field.\ntype missionSummary struct {\n\tID        string `json:\"id\"`\n\tStatus    string `json:\"status\"`\n\tType      string `json:\"type,omitempty\"`\n\tLeader    string `json:\"leader,omitempty\"`\n\tWorker    string `json:\"worker,omitempty\"`\n\tEvaluator string `json:\"evaluator,omitempty\"`\n\tTicket    string `json:\"ticket,omitempty\"`\n\tCreatedAt string `json:\"created_at,omitempty\"`\n\tClosedAt  string `json:\"closed_at,omitempty\"`\n\tVerdict   string `json:\"verdict,omitempty\"`\n}\n\ntype missionDetail struct {\n\tContract    json.RawMessage  `json:\"contract\"`\n\tLog         json.RawMessage  `json:\"log\"`\n\tDelegations []delegationInfo `json:\"delegations\"`\n\tArtifacts   []string         `json:\"artifacts\"`\n}\n\nfunc (s *server) missionsListHandler(w http.ResponseWriter, r *http.Request) {\n\trec := recorderFromContext(r.Context())\n\n\tif data, ok := s.cache.get(); ok {\n\t\trec.note(\"cache=hit\")\n\t\twriteJSONBytes(w, data)\n\t\treturn\n\t}\n\trec.note(\"cache=miss\")\n\n\tmerged, err := s.mergedMissions(r.Context(), rec)\n\tif err != nil {\n\t\twriteJSONError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\n\tdata, err := json.Marshal(merged)\n\tif err != nil {\n\t\twriteJSONError(w, http.StatusInternalServerError, fmt.Sprintf(\"marshaling missions: %v\", err))\n\t\treturn\n\t}\n\ts.cache.set(data, s.cacheTTL)\n\twriteJSONBytes(w, data)\n}\n\nfunc (s *server) missionDetailHandler(w http.ResponseWriter, r *http.Request) {\n\tid := r.PathValue(\"id\")\n\trec := recorderFromContext(r.Context())\n\n\tshowOut, err := s.runEthos(r.Context(), rec, \"mission_show\", \"mission\", \"show\", id, \"--json\")\n\tif err != nil {\n\t\twriteJSONError(w, http.StatusNotFound, err.Error())\n\t\treturn\n\t}\n\tlogOut, err := s.runEthos(r.Context(), rec, \"mission_log\", \"mission\", \"log\", id, \"--json\")\n\tif err != nil {\n\t\twriteJSONError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\tdelegations, artifacts, err := s.readMissionFS(id)\n\tif err != nil {\n\t\twriteJSONError(w, http.StatusInternalServerError, err.Error())\n\t\treturn\n\t}\n\n\twriteJSON(w, http.StatusOK, missionDetail{\n\t\tContract:    json.RawMessage(showOut),\n\t\tLog:         json.RawMessage(logOut),\n\t\tDelegations: delegations,\n\t\tArtifacts:   artifacts,\n\t})\n}\n\n// mergedMissions unions the closed-mission trace log (rich, but stale for\n// anything the log doesn't yet have a line for) with the full mission\n// list (thin, but complete). Any list entry missing from the trace log is\n// enriched with one `mission show` call each.\nfunc (s *server) mergedMissions(ctx context.Context, rec *recorder) ([]missionSummary, error) {\n\tfindOut, err := s.runEthos(ctx, rec, \"find_missions\", \"find\", \"missions\", \"--format\", \"json\")\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"running ethos find missions: %w\", err)\n\t}\n\n\tbyID := map[string]missionSummary{}\n\tfor _, line := range bytes.Split(findOut, []byte(\"\\n\")) {\n\t\tline = bytes.TrimSpace(line)\n\t\tif len(line) == 0 {\n\t\t\tcontinue\n\t\t}\n\t\tvar t traceSummary\n\t\tif err := json.Unmarshal(line, \u0026t); err != nil {\n\t\t\treturn nil, fmt.Errorf(\"parsing find-missions line: %w\", err)\n\t\t}\n\t\tbyID[t.ID] = missionSummary{\n\t\t\tID: t.ID, Status: t.Status, Type: t.Type, Leader: t.Leader,\n\t\t\tWorker: t.Worker, Evaluator: t.Evaluator, Ticket: t.Ticket,\n\t\t\tCreatedAt: t.CreatedAt, ClosedAt: t.ClosedAt, Verdict: t.Verdict,\n\t\t}\n\t}\n\n\tlistOut, err := s.runEthos(ctx, rec, \"mission_list\", \"mission\", \"list\", \"--json\", \"--status\", \"all\")\n\tif err != nil {\n\t\treturn nil, fmt.Errorf(\"running ethos mission list: %w\", err)\n\t}\n\tvar entries []listEntry\n\tif err := json.Unmarshal(listOut, \u0026entries); err != nil {\n\t\treturn nil, fmt.Errorf(\"parsing mission list: %w\", err)\n\t}\n\n\tvar toEnrich []string\n\tfor _, e := range entries {\n\t\tif _, ok := byID[e.MissionID]; !ok {\n\t\t\ttoEnrich = append(toEnrich, e.MissionID)\n\t\t}\n\t}\n\n\tif len(toEnrich) \u003e 0 {\n\t\tvar total int64\n\t\tfor _, id := range toEnrich {\n\t\t\tshowOut, elapsed, err := s.execEthos(ctx, \"mission\", \"show\", id, \"--json\")\n\t\t\tif err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"enriching mission %s: %w\", id, err)\n\t\t\t}\n\t\t\ttotal += elapsed.Milliseconds()\n\t\t\tvar c contract\n\t\t\tif err := json.Unmarshal(showOut, \u0026c); err != nil {\n\t\t\t\treturn nil, fmt.Errorf(\"parsing mission show for %s: %w\", id, err)\n\t\t\t}\n\t\t\tbyID[id] = summaryFromContract(c)\n\t\t}\n\t\trec.note(fmt.Sprintf(\"mission_show_enrich(n=%d)=%dms\", len(toEnrich), total))\n\t}\n\n\tout := make([]missionSummary, 0, len(byID))\n\tfor _, m := range byID {\n\t\tout = append(out, m)\n\t}\n\tsort.Slice(out, func(i, j int) bool { return out[i].CreatedAt \u003e out[j].CreatedAt })\n\treturn out, nil\n}\n\nfunc summaryFromContract(c contract) missionSummary {\n\tm := missionSummary{\n\t\tID: c.MissionID, Status: c.Status, Type: c.Type,\n\t\tLeader: c.Leader, Worker: c.Worker, Evaluator: c.Evaluator.Handle,\n\t\tTicket: c.Inputs.Ticket, CreatedAt: c.CreatedAt, ClosedAt: c.ClosedAt,\n\t}\n\tif len(c.Results) \u003e 0 {\n\t\tm.Verdict = c.Results[len(c.Results)-1].Verdict\n\t}\n\treturn m\n}\n","file_path":"~/Coding/punt-labs/desk/spike/deskd/missions.go"},"tool_input_hash":"3b4222d21434ddbe097ebcea654a5c65017bd8af7bf9cdb802a4401eba77c587","tool_input_preview":"{\"content\":\"package main\\n\\nimport (\\n\\t\\\"bytes\\\"\\n\\t\\\"context\\\"\\n\\t\\\"encoding/json\\\"\\n\\t\\\"fmt\\\"\\n\\t\\\"net/http\\\"\\n\\t\\\"sort\\\"\\n)\\n\\n// traceSummary is one line of `ethos find missions --format json`: t..."}
