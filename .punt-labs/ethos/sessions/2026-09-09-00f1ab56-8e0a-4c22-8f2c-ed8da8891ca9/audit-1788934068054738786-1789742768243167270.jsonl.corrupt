{"ts":"2026-09-11T05:30:51.218686584Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-deskd-8cc8192e6dcc72db","agent_type":"worker-deskd","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/spike/deskd/missions.go","new_string":"// isNotFoundErr reports whether err is the ethos CLI's \"no such mission\"\n// error, as opposed to some other failure (bad binary, corrupt store,\n// timeout) that should surface as a server error, not a 404.\nfunc isNotFoundErr(err error) bool {\n\tmsg := strings.ToLower(err.Error())\n\treturn strings.Contains(msg, \"no mission matching\") || strings.Contains(msg, \"not found\")\n}\n\nfunc summaryFromContract(c contract) missionSummary {","old_string":"func summaryFromContract(c contract) missionSummary {","replace_all":false},"tool_input_hash":"f4bf6092afacbb64a2c8848c80aa5bf1077150f3f42169fd454d6a45637cc5de","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/spike/deskd/missions.go\",\"new_string\":\"// isNotFoundErr reports whether err is the ethos CLI's \\\"no such mission\\\"\\n// error, as opposed to some other failure (ba..."}
