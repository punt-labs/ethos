{"ts":"2026-09-11T04:30:08.759355386Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-ui-85a325c3a077a9d5","agent_type":"worker-ui","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/spike/ui/src/lib/format.ts","new_string":"export function headline(row: MissionRow): { text: string; derived: boolean } {\n  const firstCriterion = row.success_criteria?.[0]\n  if (firstCriterion) {\n    // Some criteria are one giant run-on paragraph rather than a short\n    // item (a real data-model gap, not a fixture artifact — see\n    // fixtures/README.md). Prefer the first sentence when the criterion\n    // is long enough that a hard character cut would land mid-clause.\n    if (firstCriterion.length \u003e 100) {\n      const sentenceEnd = firstCriterion.slice(0, 140).search(/[.!?]\\s/)\n      if (sentenceEnd \u003e 20) {\n        return { text: firstCriterion.slice(0, sentenceEnd + 1), derived: true }\n      }\n    }\n    return { text: truncate(firstCriterion, 100), derived: true }\n  }","old_string":"export function headline(row: MissionRow): { text: string; derived: boolean } {\n  const firstCriterion = row.success_criteria?.[0]\n  if (firstCriterion) return { text: truncate(firstCriterion, 100), derived: true }","replace_all":false},"tool_input_hash":"52a73165a60c6d581098a06ff4db291806c685fd86054a8feb9a17e27ed22031","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/spike/ui/src/lib/format.ts\",\"new_string\":\"export function headline(row: MissionRow): { text: string; derived: boolean } {\\n  const firstCriterion = row.success_cr..."}
