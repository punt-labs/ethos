{"ts":"2026-09-12T01:45:19.232787763Z","session":"00f1ab56-8e0a-4c22-8f2c-ed8da8891ca9","agent_id":"aworker-redesign-f17c7e06facedc5b","agent_type":"worker-redesign","tool":"Edit","tool_input":{"file_path":"~/Coding/punt-labs/desk/apps/desk/src/lib/grouping.ts","new_string":"export function groupRows(rows: MissionSummary[]): Map\u003cGroupKey, MissionSummary[]\u003e {\n  const map = new Map\u003cGroupKey, MissionSummary[]\u003e()\n  for (const def of GROUP_ORDER) map.set(def.key, [])\n  for (const row of rows) {\n    map.get(groupFor(row))!.push(row)\n  }\n  return map\n}\n\nexport interface DayGroup {\n  /** yyyy-mm-dd, for a stable React key. */\n  key: string\n  label: string\n  rows: MissionSummary[]\n}\n\n/**\n * Default list scope (\"Recent\"): missions with activity (closed_at, else\n * created_at) within the last `withinDays` days, grouped by day and\n * ordered most-recent-first — everything else is left for the \"All\" pill\n * (groupRows/GROUP_ORDER, unchanged). `now` is injectable for tests; the\n * real call site always uses the caller's wall clock.\n */\nexport function groupByDay(rows: MissionSummary[], withinDays = 14, now: Date = new Date()): DayGroup[] {\n  const cutoff = now.getTime() - withinDays * 24 * 60 * 60 * 1000\n  const byDay = new Map\u003cstring, MissionSummary[]\u003e()\n  for (const row of rows) {\n    const iso = row.closed_at ?? row.created_at\n    if (!iso) continue\n    if (new Date(iso).getTime() \u003c cutoff) continue\n    const key = iso.slice(0, 10)\n    if (!byDay.has(key)) byDay.set(key, [])\n    byDay.get(key)!.push(row)\n  }\n  return [...byDay.keys()]\n    .sort((a, b) =\u003e (a \u003c b ? 1 : a \u003e b ? -1 : 0))\n    .map((key) =\u003e ({ key, label: formatDate(`${key}T00:00:00Z`), rows: byDay.get(key)! }))\n}","old_string":"export function groupRows(rows: MissionSummary[]): Map\u003cGroupKey, MissionSummary[]\u003e {\n  const map = new Map\u003cGroupKey, MissionSummary[]\u003e()\n  for (const def of GROUP_ORDER) map.set(def.key, [])\n  for (const row of rows) {\n    map.get(groupFor(row))!.push(row)\n  }\n  return map\n}","replace_all":false},"tool_input_hash":"666ac837920a1c742c26d0932594846aff00bb912d36c32af161f269135d1a22","tool_input_preview":"{\"file_path\":\"~/Coding/punt-labs/desk/apps/desk/src/lib/grouping.ts\",\"new_string\":\"export function groupRows(rows: MissionSummary[]): Map\\u003cGroupKey, MissionSummary[]\\u003e {\\n  const map = new Map..."}
