# Scratch files live under the workspace's .tmp/, never the system temp dir.
# Set first: everything below that calls mktemp (the identity file's lookup, the
# secrets block) must already see it on a fresh load.
export TMPDIR="$PWD/.tmp"
mkdir -p "$TMPDIR"

# Git identity (user-specific — name, email, signing key vary per contributor)
#
# watch_file is required, not decorative: direnv keys its cache on .envrc's own
# hash, so a file that .envrc merely sources is invisible to cache invalidation.
# Without this line, adding or rotating a token in git-identity.env leaves every
# repo running the stale environment until something happens to change .envrc's
# mtime — and the failure presents as a bad credential, not as stale config.
if [ -f "${HOME}/.punt-labs/git-identity.env" ]; then
  watch_file "${HOME}/.punt-labs/git-identity.env"
  source "${HOME}/.punt-labs/git-identity.env"
fi

# Beads — Hosted DoltDB connection
export BEADS_DOLT_SERVER_HOST="punt-labs-beads-1.dbs.hosted.doltdb.com"
export BEADS_DOLT_SERVER_PORT=3306
export BEADS_DOLT_SERVER_USER="tacvb9o46xu04pa5"
export BEADS_DOLT_SERVER_TLS=1

# Secrets from Proton Pass (pass-cli), account jim@luminating.us, vault `dev`.
#
# Only export when the lookup returns a non-empty value AND the variable
# isn't already set. Two failure modes this guards against:
#
# 1. An unconditional export of a failed lookup propagates as an EXPORTED
#    empty string, which then overrides any value the user set in ~/.zshrc /
#    ~/.bashrc / a parent shell. Presents downstream as an opaque 401 rather
#    than "your secret store is unreachable."
# 2. Without the already-set check, a lookup here would clobber a value the
#    user deliberately exported in a parent shell.
#
# GitHub tokens: when git-identity.env (sourced above) set
# PUNTLABS_GIT_IDENTITY=<handle>, both GH_TOKEN and GITHUB_PERSONAL_ACCESS_TOKEN
# come from item github-<handle>-pat, in the same call. The identity file
# unsets both first, so an inherited token cannot survive, and if that item is
# missing both stay unset: the personal fallback is never used for an identity,
# or GitHub MCP would authenticate as a different account from the commit
# author. With no identity, GITHUB_PERSONAL_ACCESS_TOKEN comes from the
# fallback item github-personal-access-token and GH_TOKEN is not set here.
#
# Every variable still unset is resolved by ONE `pass-cli item list --vault-name
# dev --output json --show-secrets` call, piped straight into jq inside the
# command substitution: the vault JSON never touches a file, a variable, or
# argv. jq emits `VAR=<password>` for each requested item found (Active, with a
# non-empty Login password) and `VAR:<item>` for each one that is not. When
# nothing is unset, pass-cli is not called at all. PROTON_PASS_SESSION_DIR
# selects the punt-labs account for that one call only; the default pass-cli
# session is a different (personal) account. The one exception to "one call"
# is a keyring failure, retried once with PROTON_PASS_KEY_PROVIDER=fs (see the
# key-provider comment below).
# Reporting is one stderr line per condition, and sourcing is never aborted:
#   * pass-cli or jq not on PATH: names the unloaded secrets and the fix.
#   * the keyring holds no usable key (and fs failed too): names the fs login.
#   * no session: names the login command.
#   * the list call (or jq) failed: quotes the stderr, flattened to one line.
#   * items missing from the vault: names them; the other variables still load.
#   * PUNTLABS_GIT_IDENTITY is not a valid handle: neither token is loaded.
_puntlabs_pass_session="${HOME}/.punt-labs/pass-sessions/puntlabs"
_puntlabs_want_pairs=""
_puntlabs_need=""
# _puntlabs_want VARNAME ITEM: queue VARNAME for the list call unless it is
# already set.
_puntlabs_want() {
  if [ -n "${!1:-}" ]; then return 0; fi
  _puntlabs_want_pairs="${_puntlabs_want_pairs:+${_puntlabs_want_pairs} }$1:$2"
  _puntlabs_need="${_puntlabs_need:+${_puntlabs_need} }$1"
}
_puntlabs_want BEADS_DOLT_PASSWORD          beads-dolt-password
if [ -z "${PUNTLABS_GIT_IDENTITY:-}" ]; then
  _puntlabs_want GITHUB_PERSONAL_ACCESS_TOKEN github-personal-access-token
elif [[ "${PUNTLABS_GIT_IDENTITY}" =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
  _puntlabs_want GITHUB_PERSONAL_ACCESS_TOKEN "github-${PUNTLABS_GIT_IDENTITY}-pat"
  _puntlabs_want GH_TOKEN                     "github-${PUNTLABS_GIT_IDENTITY}-pat"
else
  echo ".envrc: PUNTLABS_GIT_IDENTITY is not a valid handle (expected ^[a-z0-9][a-z0-9_-]*\$); GH_TOKEN and GITHUB_PERSONAL_ACCESS_TOKEN not loaded; re-run .bin/git-identity.sh <handle>" >&2
fi
_puntlabs_want ANTHROPIC_API_KEY            anthropic-api-key
_puntlabs_want OPENAI_API_KEY               openai-api-key
_puntlabs_want ELEVENLABS_API_KEY           elevenlabs-api-key
_puntlabs_want RESEND_API_KEY               resend-api-key
_puntlabs_want CONTEXT7_API_KEY             context7-api-key
_puntlabs_want BRAVE_API_KEY                brave-api-key
_puntlabs_want OPENROUTER_API_KEY           openrouter-api-key
_puntlabs_login="PROTON_PASS_SESSION_DIR=~/.punt-labs/pass-sessions/puntlabs pass-cli login"
if [ -z "${_puntlabs_need}" ]; then
  :
elif ! command -v pass-cli >/dev/null 2>&1; then
  echo ".envrc: pass-cli not found on PATH; secrets not loaded: ${_puntlabs_need}; install the Proton Pass CLI (macOS and Ubuntu: curl -fsSL https://proton.me/download/pass-cli/install.sh | bash), then: ${_puntlabs_login}" >&2
elif ! command -v jq >/dev/null 2>&1; then
  echo ".envrc: jq not found on PATH; secrets not loaded: ${_puntlabs_need}; install it with 'brew install jq' (macOS) or 'sudo apt install jq' (Ubuntu)" >&2
else
  # Stderr of both commands goes to a private temp file so the error line can
  # quote it; the vault JSON only ever flows through the pipe.
  _puntlabs_errf="$(mktemp 2>/dev/null)" || _puntlabs_errf=/dev/null
  # _puntlabs_list [PROVIDER]: the one list call, piped into jq. PROVIDER, when
  # given, sets PROTON_PASS_KEY_PROVIDER for this call only (a subshell).
  _puntlabs_list() {
    (
      set -o pipefail
      if [ -n "${1:-}" ]; then export PROTON_PASS_KEY_PROVIDER="$1"; fi
      PROTON_PASS_SESSION_DIR="${_puntlabs_pass_session}" \
        pass-cli item list --vault-name dev --output json --show-secrets 2>"${_puntlabs_errf}" \
      | jq -r --arg want "${_puntlabs_want_pairs}" '
          [.items[] | select(.state == "Active")
            | {t: .content.title, p: (.content.content.Login.password // "")}] as $items
          | $want | split(" ")[] | split(":") as [$v, $t]
          | ([$items[] | select(.t == $t) | .p | select(. != "")] | first) as $p
          | if $p == null then "\($v):\($t)" else "\($v)=\($p | gsub("[\r\n]"; ""))" end
        ' 2>>"${_puntlabs_errf}"
    )
  }
  # _puntlabs_readerr: pass-cli's stderr from the last call, flattened to one
  # line, in _puntlabs_err.
  _puntlabs_readerr() {
    _puntlabs_err=""
    if [ "${_puntlabs_errf}" != /dev/null ]; then
      _puntlabs_err="$(cat "${_puntlabs_errf}" 2>/dev/null)" || _puntlabs_err=""
    fi
    _puntlabs_err="${_puntlabs_err//$'\r'/}"
    _puntlabs_err="${_puntlabs_err//$'\n'/ }"
  }
  # _puntlabs_probe [PROVIDER]: run `pass-cli info` (no vault data) and keep
  # its own stderr, flattened, in _puntlabs_probe_err; the exit status is
  # info's. It needs no temp file, so the cause survives a missing mktemp.
  _puntlabs_probe() {
    _puntlabs_probe_err="$(
      if [ -n "${1:-}" ]; then export PROTON_PASS_KEY_PROVIDER="$1"; fi
      PROTON_PASS_SESSION_DIR="${_puntlabs_pass_session}" pass-cli info 2>&1 >/dev/null
    )"
    _puntlabs_probe_rc=$?
    _puntlabs_probe_err="${_puntlabs_probe_err//$'\r'/}"
    _puntlabs_probe_err="${_puntlabs_probe_err//$'\n'/ }"
    return "${_puntlabs_probe_rc}"
  }
  # Key provider. pass-cli keeps the key that unlocks its local session store
  # either in the OS keyring (PROTON_PASS_KEY_PROVIDER=keyring, the default) or
  # in a file in the session dir (fs); `env` is the third valid value. Where the
  # session was created with fs, or the host has no usable keyring (a headless
  # Linux box, whose kernel-keyutils store is cleared on reboot), the default
  # fails fast (~3 ms) with "Could not get local key from keyring ...
  # NoStorageAccess(KeyRevoked)". Behavior:
  #   * PROTON_PASS_KEY_PROVIDER already set (shell profile, parent shell):
  #     honored as is, no fallback; the user chose it.
  #   * unset: try the default; only on a keyring error, retry once with fs for
  #     that call only. A host whose keyring works is never touched (one call,
  #     as before), so the fallback cannot regress macOS; a keyring-less host
  #     loads its secrets with no per-machine config. The retry is gated on the
  #     keyring error, not on any file in the session dir, so it does not
  #     depend on pass-cli's on-disk layout.
  #   * both fail: one line. The fs login is named only when fs failed for
  #     want of a session ("requires an authenticated client" and the other
  #     no-session messages pass-cli 2.6.0 carries); any other fs error is
  #     quoted as the cause with no login advice. A pinned provider that fails
  #     on the keyring is told to unset it or set it to fs.
  # Like the session dir, the provider is never exported to the shell.
  # With no temp file (mktemp failed) the list call's stderr is lost, so the
  # cause is read from a `pass-cli info` probe instead.
  _puntlabs_kp="${PROTON_PASS_KEY_PROVIDER:-}"
  _puntlabs_keyring_err=""
  _puntlabs_fs_tried=""
  _puntlabs_ok=""
  _puntlabs_info_ok=""
  _puntlabs_probe_err=""
  if _puntlabs_out="$(_puntlabs_list "${_puntlabs_kp}")"; then
    _puntlabs_ok=1
  elif [ -z "${_puntlabs_kp}" ]; then
    _puntlabs_readerr
    if [ -z "${_puntlabs_err}" ] && ! _puntlabs_probe ""; then
      _puntlabs_err="${_puntlabs_probe_err}"
    fi
    case "${_puntlabs_err}" in
      *[Kk]eyring*|*NoStorageAccess*)
        _puntlabs_keyring_err="${_puntlabs_err}"
        _puntlabs_kp=fs
        _puntlabs_fs_tried=1
        if _puntlabs_out="$(_puntlabs_list fs)"; then _puntlabs_ok=1; fi
        ;;
    esac
  fi
  if [ -n "${_puntlabs_ok}" ]; then
    _puntlabs_missing=""
    while IFS= read -r _puntlabs_line || [ -n "${_puntlabs_line}" ]; do
      [ -n "${_puntlabs_line}" ] || continue
      case "${_puntlabs_line}" in
        *=*) _puntlabs_var="${_puntlabs_line%%=*}" ;;
        *)
          # VAR:<item> -- the item is missing, trashed, or has no password.
          _puntlabs_var="${_puntlabs_line%%:*}"
          case " ${_puntlabs_need} " in *" ${_puntlabs_var} "*) ;; *) continue ;; esac
          _puntlabs_missing="${_puntlabs_missing:+${_puntlabs_missing}, }${_puntlabs_var} (${_puntlabs_line#*:})"
          continue
          ;;
      esac
      # Only the names this block asked for are ever touched.
      case " ${_puntlabs_need} " in *" ${_puntlabs_var} "*) ;; *) continue ;; esac
      _puntlabs_val="${_puntlabs_line#*=}"
      if [ -z "${!_puntlabs_var:-}" ] && [ -n "${_puntlabs_val}" ]; then
        export "${_puntlabs_var}=${_puntlabs_val}"
      fi
    done <<<"${_puntlabs_out}"
    if [ -n "${_puntlabs_missing}" ]; then
      echo ".envrc: Proton Pass vault dev has no item (or an empty password) for: ${_puntlabs_missing}; add the items, or set the variables another way" >&2
    fi
  else
    # _puntlabs_err: the last list call's stderr. The info probe runs only when
    # it is needed: to tell "no session" from a list failure, or to recover a
    # cause the missing temp file lost.
    _puntlabs_readerr
    if [ -z "${_puntlabs_keyring_err}" ] || [ -z "${_puntlabs_err}" ]; then
      if _puntlabs_probe "${_puntlabs_kp}"; then
        _puntlabs_info_ok=1
      elif [ -z "${_puntlabs_err}" ]; then
        _puntlabs_err="${_puntlabs_probe_err}"
      fi
    fi
    if [ -z "${_puntlabs_keyring_err}" ] && [ "${_puntlabs_kp}" != fs ]; then
      # A pinned provider (keyring or env) that fails on the keyring is
      # reported on a keyring line below, never as "no session".
      case "${_puntlabs_err}" in
        *[Kk]eyring*|*NoStorageAccess*) _puntlabs_keyring_err="${_puntlabs_err}" ;;
      esac
    fi
    if [ -n "${_puntlabs_keyring_err}" ] && [ -z "${_puntlabs_fs_tried}" ]; then
      echo ".envrc: PROTON_PASS_KEY_PROVIDER=${_puntlabs_kp} is set and pass-cli cannot read its local key from the system keyring; secrets not loaded: ${_puntlabs_need}; unset PROTON_PASS_KEY_PROVIDER so the fs retry can run, or set it to fs; error: ${_puntlabs_keyring_err}" >&2
    elif [ -n "${_puntlabs_keyring_err}" ]; then
      case "${_puntlabs_err}" in
        *"requires an authenticated client"*|*"is not logged in"*|*"session has been invalidated"*|*"there is no session"*)
          echo ".envrc: pass-cli cannot read its local key from the system keyring; secrets not loaded: ${_puntlabs_need}; the fs key provider has no session; log in with the filesystem key provider: PROTON_PASS_KEY_PROVIDER=fs ${_puntlabs_login} (then optionally export PROTON_PASS_KEY_PROVIDER=fs in your shell profile to skip the keyring attempt); error: ${_puntlabs_keyring_err}; fs retry error: ${_puntlabs_err}" >&2
          ;;
        *)
          echo ".envrc: pass-cli cannot read its local key from the system keyring, and the fs key provider failed too; secrets not loaded: ${_puntlabs_need}; error: ${_puntlabs_keyring_err}; fs retry error: ${_puntlabs_err:-no error output}" >&2
          ;;
      esac
    elif [ -z "${_puntlabs_info_ok}" ]; then
      echo ".envrc: pass-cli has no session for the punt-labs account; secrets not loaded: ${_puntlabs_need}; run: ${_puntlabs_kp:+PROTON_PASS_KEY_PROVIDER=${_puntlabs_kp} }${_puntlabs_login}" >&2
    else
      echo ".envrc: pass-cli item list failed; secrets not loaded: ${_puntlabs_need}; error: ${_puntlabs_err:-no error output}" >&2
    fi
  fi
  if [ "${_puntlabs_errf}" != /dev/null ]; then rm -f "${_puntlabs_errf}"; fi
  unset -f _puntlabs_list _puntlabs_readerr _puntlabs_probe
fi
unset -f _puntlabs_want
unset _puntlabs_pass_session _puntlabs_want_pairs _puntlabs_need _puntlabs_errf _puntlabs_out _puntlabs_login
unset _puntlabs_line _puntlabs_var _puntlabs_val _puntlabs_err _puntlabs_missing
unset _puntlabs_kp _puntlabs_keyring_err _puntlabs_fs_tried _puntlabs_ok
unset _puntlabs_info_ok _puntlabs_probe_err _puntlabs_probe_rc

# Local overrides (last — wins over everything above)
source_env_if_exists .envrc.local
